#
# server/.env 예시. 실제 값은 `cp .env.example .env` 후 채우세요.
# ⚠️ .env 파일은 절대로 커밋하지 마세요. API 키는 오직 이 서버에만 존재해야 합니다.

# Anthropic API 키(서버 전용). 콘솔에서 발급한 키를 붙여넣으세요.
# 브라우저/프론트/리포지토리에는 절대 두지 않습니다.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# 프록시 포트(선택, 기본 8790)
PORT=8790

# CORS 허용 오리진(선택, 기본 *). 배포 시 프론트 도메인으로 제한 권장.
# CORS_ORIGIN=https://clsoftlab-lang.github.io

# --- 비용·모델 옵션(선택) ---------------------------------------------------
# 기본 모델은 비용 우선 claude-haiku-4-5. 품질이 더 필요하면 상향하세요.
#   AI_MODEL=claude-sonnet-5   또는   AI_MODEL=claude-opus-5
# AI_MODEL=claude-haiku-4-5

# 상위 모델(sonnet/opus)에서만 적용되는 effort (haiku 는 무시). 기본 low.
# AI_EFFORT=low

# 비용 가드레일: 분당 IP당 요청 수 제한(기본 20)
# AI_RATE_LIMIT_PER_MIN=20

# 비용 가드레일: 월간 토큰 예산(기본 2,000,000). 초과 시 429 {fallback:true} → 프론트 mock 폴백
# AI_MONTHLY_TOKEN_CAP=2000000
