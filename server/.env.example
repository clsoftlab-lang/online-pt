#
# server/.env 예시. 실제 값은 `cp .env.example .env` 후 채우세요.
# ⚠️ .env 파일은 절대로 커밋하지 마세요. API 키는 오직 이 서버에만 존재해야 합니다.

# Anthropic API 키(서버 전용). 콘솔에서 발급한 키를 붙여넣으세요.
# 브라우저/프론트/리포지토리에는 절대 두지 않습니다.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# 프록시 포트(선택, 기본 8790)
PORT=8790

# CORS 허용 오리진(선택, 기본 *). 배포 시 프론트 도메인으로 제한 권장.
# CORS_ORIGIN=https://clsoftlab-lang.github.io
